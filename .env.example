# Application Configuration
APP_NAME=Fraud Detection API
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true

# MLflow Tracking & Model Registry Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_NAME=FraudDetectionModel
MODEL_VERSION=1
MODEL_STAGE=None
MODEL_FALLBACK_PATH=data/fraud_model.pkl

# Decision Threshold for Fraud Classification
FRAUD_PROBABILITY_THRESHOLD=0.50

# PostgreSQL Backend (for MLflow Tracking Server in Docker Compose)
POSTGRES_USER=mlflow_user
POSTGRES_PASSWORD=mlflow_password
POSTGRES_DB=mlflow_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
